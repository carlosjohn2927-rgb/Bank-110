CI_ENV=development
VP_BASE_URL=
VP_DB_DRIVER=sqlite
VP_SQLITE_PATH=application/cache/production.sqlite

# For cPanel MySQL production, use:
# VP_DB_DRIVER=mysqli
# VP_DB_HOST=localhost
# VP_DB_PORT=3306
# VP_DB_NAME=cpaneluser_northwest
# VP_DB_USER=cpaneluser_bankuser
# VP_DB_PASS=CHANGE_THIS_DATABASE_PASSWORD

VP_ENCRYPTION_KEY=dev-encryption-key-1234567890-abcdef-123456
VP_AUTH_SECRET=dev-auth-secret-1234567890-abcdef-1234567890
VP_SESSION_DRIVER=files
VP_SESSION_PATH=assets/logs/sessions
VP_SESSION_EXPIRATION=7200
VP_COOKIE_SECURE=false
VP_LOG_THRESHOLD=2
VP_CACHE_DRIVER=file
VP_CACHE_PATH=assets/logs/cache
VP_UPLOAD_PATH=assets/uploads
VP_MAX_UPLOAD_KB=5120
VP_MAIL_PROTOCOL=smtp
VP_MAIL_HOST=
VP_MAIL_PORT=587
VP_MAIL_USER=
VP_MAIL_PASS=
VP_MAIL_CRYPTO=tls
VP_MAIL_FROM=support@yourdomain.com
VP_MAIL_FROM_NAME=NorthWest Financial Ltd.
VP_API_KEY=
VP_THIRD_PARTY_SECRET=
VP_SCHEDULER_KEY=dev-scheduler-key-1234567890
